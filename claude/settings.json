{
  "cleanupPeriodDays": 30,
  "env": {
    "API_TIMEOUT_MS": "300000",
    "VISUAL": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/VJ_Rodriguguez/.claude/prompt-boost.ps1",
    "CLAUDE_REAL_EDITOR": "notepad"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/VJ_Rodriguguez/.claude/statusline.ps1",
    "padding": 0,
    "refreshInterval": 5
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /System*)",
      "Bash(del /f /s /q C:\\Windows*)",
      "Bash(rm -rf /usr)",
      "Bash(sudo rm -rf /)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File C:/Users/VJ_Rodriguguez/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.ps1",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/VJ_Rodriguguez/.claude/hooks/ship-loop/build-scripts/pretool-deploy-gate.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/VJ_Rodriguguez/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.ps1",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "sentinal|verity|aesthetica",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/VJ_Rodriguguez/.claude/hooks/ship-loop/build-scripts/subagentstop-review-log.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
